# ---- Required ----
# Neon Postgres connection string (pooled). Server-only.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Random 32+ char secret used to sign admin session cookies.  openssl rand -base64 48
SESSION_SECRET=
# 32-byte key (base64) used to encrypt Google OAuth tokens at rest.  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Public site URL, no trailing slash (used for OAuth redirect, sitemap, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Google Calendar (optional until the clinic connects) ----
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/admin/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Transactional email (optional) ----
# Resend API key + a verified sender, e.g. "SPYNUS Physiotherapy <bookings@yourdomain.in>"
RESEND_API_KEY=
EMAIL_FROM=

# ---- Scheduled jobs (optional) ----
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
